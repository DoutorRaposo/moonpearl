 // Draw a whole line of a 2bpp background layer into bgBuffers
+// Widescreen HUD: the HUD is BG3's tilemap rows 2-7 (lines 16-63). Its left part (magic meter,
+// item, rupees, bombs, arrows, keys) and right part (life, hearts) are drawn out at the edges of
+// the widescreen picture, as far out as they sit from the edges of the 256-pixel one.
+enum { kHudTop = 16, kHudBottom = 64, kHudSplit = 152 };
+
+static bool PpuIsHudLine(Ppu *ppu, uint y) {
+  const BgLayer *bg3 = &ppu->bgLayer[2];
+  return ppu->hudShift != 0 && bg3->hScroll == 0 && bg3->vScroll == 0 && y >= kHudTop && y < kHudBottom;
+}
+
