 }
 
+static bool g_widescreen_hud;
+
+// Moves the HUD's side blocks to the edges of a widescreen picture.
+void ZeldaSetWidescreenHud(bool enabled) {
+  g_widescreen_hud = enabled;
+}
+
+// Whether BG3's top rows hold the HUD: in play and in the interface modes that keep it (text,
+// potions, the desert prayer, the save and quit box), but not the item menu, maps, file select
+// and such, which draw other things there.
+static bool HudIsShown(void) {
+  switch (main_module_index) {
+  case 7: case 9: case 11: case 15: case 16: case 17: case 19: case 21: case 22: case 24:
+    return true;
+  case 14:
+    return submodule_index == 2 || submodule_index == 4 || submodule_index == 5 ||
+           submodule_index == 8 || submodule_index == 9 || submodule_index == 11;
+  default:
+    return false;
+  }
+}
+
 void ZeldaDrawPpuFrame(uint8 *pixel_buffer, size_t pitch, uint32 render_flags) {
   SimpleHdma hdma_chans[2];
 
+  g_zenv.ppu->hudShift = g_widescreen_hud && HudIsShown() ? g_zenv.ppu->extraLeftRight : 0;
   PpuBeginDrawing(g_zenv.ppu, pixel_buffer, pitch, render_flags);
 
   dma_startDma(g_zenv.dma, HDMAEN_copy, true);
