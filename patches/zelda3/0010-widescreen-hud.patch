-    uint w = win.edges[windex + 1] - win.edges[windex];
-    PpuZbufType *dstz = ppu->bgBuffers[sub].data + win.edges[windex] + kPpuExtraLeftRight;
+  for (size_t windex = 0; windex < (nspans ? (size_t)nspans : win.nr); windex++) {
+    int lo, hi, shift = 0;
