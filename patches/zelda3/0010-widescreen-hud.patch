     const uint16 *tp_next = tps[(x >> 8 & 1) ^ 1];
@@ -858,6 +885,12 @@ static NOINLINE void PpuDrawWholeLine(Ppu *ppu, uint y) {
   // Render main screen
   PpuDrawBackgrounds(ppu, y, false);
 
