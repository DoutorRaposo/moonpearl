   int tileadr = ppu->bgLayer[layer].tileAdr, pixel;
   int tileadr1 = tileadr + 7 - (y & 0x7), tileadr0 = tileadr + (y & 0x7);
 
+  // Widescreen HUD: the left part shifted out left, the right part out right; the gap between
+  // them stays empty.
+  int span_lo[2], span_hi[2], span_shift[2], nspans = 0;
+  if (layer == 2 && !IS_SCREEN_WINDOWED(ppu, sub, layer) && PpuIsHudLine(ppu, line)) {
+    int d = ppu->hudShift;
+    span_lo[0] = -d, span_hi[0] = kHudSplit - d, span_shift[0] = d;
+    span_lo[1] = kHudSplit + d, span_hi[1] = 256 + d, span_shift[1] = -d;
+    nspans = 2;
+  }
+
   const uint16 *addr;
-  for (size_t windex = 0; windex < win.nr; windex++) {
