+static SDL_SpinLock g_filter_lock;
+static bool g_filter_pending, g_filter_linear;
+static char g_filter_shader[256];
+
+// Changes the image filter while the game runs. Only the OpenGL output methods support shaders.
+void ZeldaSetImageFilter(const char *shader, bool linear_filtering) {
+  SDL_AtomicLock(&g_filter_lock);
+  snprintf(g_filter_shader, sizeof(g_filter_shader), "%s", shader ? shader : "");
+  g_filter_linear = linear_filtering;
+  g_filter_pending = true;
+  SDL_AtomicUnlock(&g_filter_lock);
+}
+
+static bool ApplyPendingImageFilter(void) {
+  char shader[sizeof(g_filter_shader)];
+  if (!g_filter_pending)
+    return false;
+  SDL_AtomicLock(&g_filter_lock);
+  g_filter_pending = false;
+  memcpy(shader, g_filter_shader, sizeof(shader));
+  g_config.linear_filtering = g_filter_linear;
+  SDL_AtomicUnlock(&g_filter_lock);
+  if (g_config.output_method == kOutputMethod_OpenGL || g_config.output_method == kOutputMethod_OpenGL_ES)
+    OpenGLRenderer_SetShader(shader);
+  return true;
+}
 
